{
  "name": "dsh-plugin-mojobox",
  "version": "0.0.1-p3.1",
  "private": true,
  "description": "Mojobox 官方客户端整合包管理插件（本地开发版）",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lanyun077/Mojobox-Installer.git"
  },
  "homepage": "https://github.com/lanyun077/Mojobox-Installer#readme",
  "bugs": {
    "url": "https://github.com/lanyun077/Mojobox-Installer/issues"
  },
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=24.9.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-ui-settings-models"
      ],
      "external": [
        "react"
      ]
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "npm run build && node --test test/*.test.mjs",
    "typecheck": "tsc --noEmit"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "schema"
  ],
  "dependencies": {
    "ajv": "8.20.0",
    "semver": "7.8.6",
    "tar": "7.5.22",
    "yauzl": "3.4.0"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/semver": "7.8.0",
    "@types/yauzl": "3.4.0",
    "@types/yazl": "3.3.1",
    "typescript": "7.0.2",
    "yazl": "3.3.1"
  }
}
